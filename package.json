{
  "name": "pi-free-search",
  "version": "0.1.0",
  "description": "Pi web search extension: 13 engines with automatic fallback, time filtering, and cache",
  "keywords": [
    "pi-package",
    "web-search"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [],
    "prompts": []
  },
  "scripts": {
    "build":"tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:smoke": "tsx --test --test-timeout=30000 test/smoke/*.test.ts",
    "clean":"rm -rf dist"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typebox": "*",
    "typescript": "^5.7.2"
  }
}
